{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "mission",
    "requirements",
    "repositories",
    "gaps",
    "options",
    "adr",
    "evidence",
    "limits",
    "next_actions",
    "status"
  ],
  "properties": {
    "version": {
      "const": "D099-AA0-v1"
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FR",
        "NFR"
      ],
      "properties": {
        "FR": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "acceptance",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "NFR": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "acceptance",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "canonical_owner",
          "revision",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "canonical_owner": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "source",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "approach",
          "advantages",
          "risks",
          "evidence_limit"
        ],
        "properties": {
          "id": {
            "enum": [
              "S1",
              "S2",
              "S3"
            ]
          },
          "approach": {
            "type": "string",
            "minLength": 1
          },
          "advantages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_limit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "chosen",
        "reason",
        "approval_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PROPOSED",
            "APPROVED",
            "REJECTED"
          ]
        },
        "chosen": {
          "enum": [
            "S1",
            "S2",
            "S3"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "level",
          "source",
          "scope"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "PLANNED",
              "DESIGNED",
              "IMPLEMENTED",
              "STATIC_VALIDATED",
              "CI_VERIFIED",
              "LOCAL_RUNTIME_PROVEN",
              "KIND_RUNTIME_PROVEN",
              "CRC_RUNTIME_PROVEN",
              "PRODUCTION_OPERATED"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "PLANNED",
        "DESIGNED",
        "IMPLEMENTED",
        "STATIC_VALIDATED",
        "CI_VERIFIED",
        "LOCAL_RUNTIME_PROVEN",
        "KIND_RUNTIME_PROVEN",
        "CRC_RUNTIME_PROVEN",
        "PRODUCTION_OPERATED"
      ]
    }
  }
}
